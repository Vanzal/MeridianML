{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meridian",
  "version": "2.1.0",
  "identifier": "ml.meridian.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Ein eigenes Sprachmodell – von Grund auf gebaut",
    "longDescription": "Meridian baut ein kleines GPT-Sprachmodell komplett selbst (Tokenizer, Transformer, Training, Sampling) und zeigt jeden Schritt live.",
    "copyright": "MIT-Lizenz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/uv"],
    "resources": {
      "resources/app/": "app/",
      "resources/wheels/": "wheels/",
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
